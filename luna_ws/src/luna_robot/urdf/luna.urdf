<?xml version="1.0"?>
<!-- Luna R2 kinematic model (docs/TASARIM_R2.md). ROS REP-103 axes: x forward, y left, z up. base_link lies on the
     floor under the turning centre, which is the midpoint of the two drive wheels: the robot turns in place inside
     its own round outline (radius 0.180 m), so a rotation sweeps no wider than the body.
     The head is fixed to the torso: no pan/tilt joints. Looking around is done by the eyes on the screen and, for a
     larger turn, by the whole body (core/attention.py). This file is the only place a mount pose is written down:
     core/robot_model.py reads it for the simulator, dock_nav_node and the tests; Nav2 and SLAM get it through TF. -->
<robot name="luna">
  <link name="base_footprint"/>
  <link name="base_link">
    <!-- bumper ring + torso: Ø 0.360 m from 15 mm above the floor to the shoulder plate at Z345 -->
    <visual><origin xyz="0 0 0.180"/><geometry><cylinder radius="0.180" length="0.330"/></geometry></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <!-- Drive: 2 × Pololu 37D 70:1 12 V with 64 CPR encoders, Pololu 80 × 10 mm wheels on 6 mm hubs, wheel centres at
       y ±0.150 (separation 0.300 m). Two 1" ball casters on the centre line at x ±0.110 keep the robot from tipping
       forward or back; one of the four contacts must be sprung (docs/TASARIM_R2.md, "Şasi"). -->
  <link name="wheel_left"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.040" length="0.010"/></geometry></visual></link>
  <joint name="wheel_left_joint" type="fixed"><parent link="base_link"/><child link="wheel_left"/><origin xyz="0 0.150 0.040"/></joint>
  <link name="wheel_right"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.040" length="0.010"/></geometry></visual></link>
  <joint name="wheel_right_joint" type="fixed"><parent link="base_link"/><child link="wheel_right"/><origin xyz="0 -0.150 0.040"/></joint>
  <link name="caster_front"/>
  <joint name="caster_front_joint" type="fixed"><parent link="base_link"/><child link="caster_front"/><origin xyz="0.110 0 0.0127"/></joint>
  <link name="caster_rear"/>
  <joint name="caster_rear_joint" type="fixed"><parent link="base_link"/><child link="caster_rear"/><origin xyz="-0.110 0 0.0127"/></joint>

  <!-- Fixed head on a short neck: 0.12 deep × 0.22 wide × 0.16 tall, Z360–520. -->
  <link name="head_link">
    <visual><origin xyz="0.010 0 0.080"/><geometry><box size="0.120 0.220 0.160"/></geometry></visual>
  </link>
  <joint name="head_joint" type="fixed"><parent link="base_link"/><child link="head_link"/><origin xyz="0 0 0.360"/></joint>
  <!-- Face: Waveshare 5.5" HDMI AMOLED (1920 × 1080 landscape, USB touch) behind a smoked acrylic cover, centre Z440,
       tilted back 8° to meet the eyes of a child. x along the screen normal. -->
  <link name="face_display"/>
  <joint name="face_display_joint" type="fixed"><parent link="head_link"/><child link="face_display"/><origin xyz="0.072 0 0.080" rpy="0 -0.1396 0"/></joint>
  <!-- Face camera: Raspberry Pi Camera v2 (IMX219, 62.2° × 48.8°) over the screen, pitched up 12° so standing and
       sitting children both fit. Behind the privacy slider (docs/TASARIM_R2.md, "Gizlilik"). -->
  <link name="face_camera_link"/>
  <joint name="face_camera_joint" type="fixed"><parent link="head_link"/><child link="face_camera_link"/><origin xyz="0.072 0 0.145" rpy="0 -0.2094 0"/></joint>
  <link name="face_camera_optical_frame"/>
  <joint name="face_camera_optical_joint" type="fixed"><parent link="face_camera_link"/><child link="face_camera_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>

  <!-- RPLIDAR C1 on top of the head, over the turning centre: base at Z520, laser plane 29.8 mm above it (datasheet).
       Nothing of the robot is above the plane. Yaw −90°: sllidar_ros2 (C1 launch, inverted=false) puts +x toward the
       cable exit, which points to the robot's right. -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="0.0000 0.0000 0.5498" rpy="0.0000 -0.0000 -1.5708"/></joint>

  <!-- Front depth camera: Orbbec Gemini 336 (active stereo with IR projector, 90° × 65° depth, 0.10–20 m, colour
       1920 × 1080 86° × 55°, 6-axis IMU) in the torso front, 15° nose down. camera_link = enclosure centre, x along
       the optical axes. The optical frames carry OrbbecSDK_ROS2's names (camera_name "camera"); with depth:=gemini
       the driver publishes them from its factory calibration below camera_link and luna.launch.py drops these copies,
       so no frame has two parents. The colour camera also reads the dock tag (core/dock_tag.py). -->
  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.1650 0.0000 0.2700" rpy="0.0000 0.2618 0.0000"/></joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_color_optical_frame"/><origin xyz="0 0.0080 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
  <link name="camera_imu_frame"/>
  <joint name="camera_imu_joint" type="fixed"><parent link="camera_link"/><child link="camera_imu_frame"/></joint>

  <!-- Microphones: ReSpeaker Mic Array v2.0 (XVF-3000, Ø 70 mm) flat on the shoulder plate behind the neck, under a
       perforated grille, fixed to the body: its direction of arrival is a base_link bearing after one calibration
       (doa_zero_deg / doa_direction in config/luna.yaml). 200 mm below the LiDAR, away from any motor. -->
  <link name="mic_array"/>
  <joint name="mic_array_joint" type="fixed"><parent link="base_link"/><child link="mic_array"/><origin xyz="-0.0700 0 0.3480"/></joint>

  <!-- Corner ToF, 4 × VL53L1X (ROI 16 × 4: 27° wide, ≈ 15° tall), in windows of the bumper ring 100 mm above the
       floor, looking straight ahead / straight back. Not turned outward: tof_range_node marks a reading as an arc
       across the whole 27° cone, and a cone that meets a side wall obliquely then marks points up to 20 cm in front of
       it, which closed a 0.68 m passage in the simulator (README_TR.md, "Engel algılama"). Straight, a wall beside
       the robot stays beyond the 0.70 m range. The round body needs no side coverage: turning in place sweeps nothing.
       +x along the beam. Names follow the robot's own sides and the /luna/mcu/corners order [FL, FR, BL, BR]. -->
  <link name="tof_fl"/>
  <joint name="tof_fl_joint" type="fixed"><parent link="base_link"/><child link="tof_fl"/><origin xyz="0.1434 0.1004 0.1000" rpy="0 0 0"/></joint>
  <link name="tof_fr"/>
  <joint name="tof_fr_joint" type="fixed"><parent link="base_link"/><child link="tof_fr"/><origin xyz="0.1434 -0.1004 0.1000" rpy="0 0 0"/></joint>
  <link name="tof_bl"/>
  <joint name="tof_bl_joint" type="fixed"><parent link="base_link"/><child link="tof_bl"/><origin xyz="-0.1434 0.1004 0.1000" rpy="0 0 3.1416"/></joint>
  <link name="tof_br"/>
  <joint name="tof_br_joint" type="fixed"><parent link="base_link"/><child link="tof_br"/><origin xyz="-0.1434 -0.1004 0.1000" rpy="0 0 3.1416"/></joint>
  <!-- Floor ToF (cliff), 4 × VL53L1X looking straight down (+x down), windows 60 mm above the floor at the front and
       rear edge, ahead of the casters (x ±0.110) by more than the stopping distance (docs/TASARIM_R2.md, "Uçurum").
       /luna/mcu/cliff order [FL, BL, FR, BR]. -->
  <link name="tof_down_fl"/>
  <joint name="tof_down_fl_joint" type="fixed"><parent link="base_link"/><child link="tof_down_fl"/><origin xyz="0.1540 0.0720 0.0600" rpy="0 1.5708 0"/></joint>
  <link name="tof_down_fr"/>
  <joint name="tof_down_fr_joint" type="fixed"><parent link="base_link"/><child link="tof_down_fr"/><origin xyz="0.1540 -0.0720 0.0600" rpy="0 1.5708 0"/></joint>
  <link name="tof_down_bl"/>
  <joint name="tof_down_bl_joint" type="fixed"><parent link="base_link"/><child link="tof_down_bl"/><origin xyz="-0.1540 0.0720 0.0600" rpy="0 1.5708 0"/></joint>
  <link name="tof_down_br"/>
  <joint name="tof_down_br_joint" type="fixed"><parent link="base_link"/><child link="tof_down_br"/><origin xyz="-0.1540 -0.0720 0.0600" rpy="0 1.5708 0"/></joint>

  <!-- Dock contacts: three copper strips under the robot (CHG+, P4 ID, GND; 40 mm across, 12 mm along x, 16 mm
       pitch), centred 60 mm ahead of and 60 mm left of the turning centre, 15 mm above the floor: beside the front
       caster's track, so the caster never rolls over the dock's spring pins. The dock's wheel funnel centres the
       robot to ±5 mm and its wheel stops end the drive at the seat (docs/TASARIM_R2.md, "Dock"). -->
  <link name="dock_contact"/>
  <joint name="dock_contact_joint" type="fixed"><parent link="base_link"/><child link="dock_contact"/><origin xyz="0.060 0.060 0.015"/></joint>
</robot>
