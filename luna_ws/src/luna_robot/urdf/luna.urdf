<?xml version="1.0"?>
<!-- Luna R05 simplified kinematic model. Frames from CAD (mm → m) with ROS REP-103 axes:
     CAD front is −Y, so  x_ros = −Y_cad,  y_ros = +X_cad,  z_ros = Z_cad.
     NOTE: CAD part names *_L sit at X<0, i.e. on the robot's own RIGHT side (y_ros < 0).
     Pan axis CAD (0, 30, 355) about Z; tilt axis CAD (0, 30, 465) about X (= ROS y). -->
<robot name="luna">
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.235"/><geometry><box size="0.25 0.26 0.22"/></geometry></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <link name="track_left"><visual><origin xyz="0 0 0.072"/><geometry><box size="0.34 0.05 0.144"/></geometry></visual></link>
  <joint name="track_left_joint" type="fixed"><parent link="base_link"/><child link="track_left"/><origin xyz="0 0.159 0"/></joint>
  <link name="track_right"><visual><origin xyz="0 0 0.072"/><geometry><box size="0.34 0.05 0.144"/></geometry></visual></link>
  <joint name="track_right_joint" type="fixed"><parent link="base_link"/><child link="track_right"/><origin xyz="0 -0.159 0"/></joint>

  <link name="head_pan_link"/>
  <joint name="head_pan" type="revolute">
    <parent link="base_link"/><child link="head_pan_link"/><origin xyz="-0.030 0 0.355"/>
    <axis xyz="0 0 1"/><limit lower="-1.047" upper="1.047" effort="2.0" velocity="1.57"/>
  </joint>
  <link name="head_tilt_link">
    <visual><origin xyz="0.025 0 0.010"/><geometry><box size="0.11 0.24 0.09"/></geometry></visual>
  </link>
  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link"/><child link="head_tilt_link"/><origin xyz="0 0 0.110"/>
    <axis xyz="0 1 0"/><limit lower="-0.209" upper="0.209" effort="2.0" velocity="0.78"/>
  </joint>
  <link name="camera_left_link"/>
  <!-- R06 camera model (Arducam B0630): lens front Y−37, entrance pupil taken 3 mm behind it (the R06 FOV apex)
       → x 0.034 in base_link, 0.064 ahead of the tilt axis; lens centre Z475 and CAD X +62 for camera_left
       (REF_R06_CAM_R), X −62 for camera_right (REF_R06_CAM_L).
       *_optical_frame: ROS camera convention (z out of the lens, x right, y down), the frame_id of the images. -->
  <joint name="camera_left_joint" type="fixed"><parent link="head_tilt_link"/><child link="camera_left_link"/><origin xyz="0.064 0.062 0.010"/></joint>
  <link name="camera_left_optical_frame"/>
  <joint name="camera_left_optical_joint" type="fixed"><parent link="camera_left_link"/><child link="camera_left_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
  <link name="camera_right_link"/>
  <joint name="camera_right_joint" type="fixed"><parent link="head_tilt_link"/><child link="camera_right_link"/><origin xyz="0.064 -0.062 0.010"/></joint>
  <link name="camera_right_optical_frame"/>
  <joint name="camera_right_optical_joint" type="fixed"><parent link="camera_right_link"/><child link="camera_right_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>

  <!-- RPLIDAR C1 placeholder scan plane Z580 (R05 LiDAR check); real optical height to be verified (R08).
       This is the only place the LiDAR pose is written: core/robot_model.py reads it for the simulator, dock_nav_node
       and the tests. -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="-0.070 0 0.580"/></joint>

  <!-- Front depth camera: Luxonis OAK-D Lite (fixed focus), 91 × 28 × 17.5 mm, depth 73° × 58°, MinZ ≈ 0.35 m.
       PROVISIONAL mount until the R08 CAD gives the real one: top front of the body, centred, 15° nose down.
       Like the LiDAR, this pose is written only here (sim_depth_node and the 2.5D simulator read it, Nav2 gets it
       through TF). oakd_link: x forward (depthai_ros_driver hangs its own frames below it via parent_frame). -->
  <link name="oakd_link"/>
  <joint name="oakd_joint" type="fixed"><parent link="base_link"/><child link="oakd_link"/><origin xyz="0.105 0 0.365" rpy="0 0.2617993877991494 0"/></joint>
  <link name="oakd_optical_frame"/>
  <joint name="oakd_optical_joint" type="fixed"><parent link="oakd_link"/><child link="oakd_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>

  <!-- Corner ToF, Pololu #3415 VL53L1X: cone apex from R07 FOV_R06_TOF_* (CAD X ±93.55, Y ∓168.88, Z 101.0).
       Each looks straight out along ±x (27° cone), not diagonally. Robot-frame names in /luna/mcu/corners order
       [FL, FR, BL, BR]: tof_fl = CAD *_F_R (X > 0 is the robot's LEFT), tof_fr = *_F_L, tof_bl = *_B_R, tof_br = *_B_L.
       x along the beam: /luna/tof/* (sensor_msgs/Range) are published in these frames. -->
  <link name="tof_fl"/>
  <joint name="tof_fl_joint" type="fixed"><parent link="base_link"/><child link="tof_fl"/><origin xyz="0.16888 0.09355 0.101"/></joint>
  <link name="tof_fr"/>
  <joint name="tof_fr_joint" type="fixed"><parent link="base_link"/><child link="tof_fr"/><origin xyz="0.16888 -0.09355 0.101"/></joint>
  <link name="tof_bl"/>
  <joint name="tof_bl_joint" type="fixed"><parent link="base_link"/><child link="tof_bl"/><origin xyz="-0.16888 0.09355 0.101" rpy="0 0 3.141592653589793"/></joint>
  <link name="tof_br"/>
  <joint name="tof_br_joint" type="fixed"><parent link="base_link"/><child link="tof_br"/><origin xyz="-0.16888 -0.09355 0.101" rpy="0 0 3.141592653589793"/></joint>

  <link name="face_display"/>
  <joint name="face_display_joint" type="fixed"><parent link="base_link"/><child link="face_display"/><origin xyz="0.115 0 0.256" rpy="0 -0.1666 0"/></joint>
  <link name="dock_contact"/>
  <joint name="dock_contact_joint" type="fixed"><parent link="base_link"/><child link="dock_contact"/><origin xyz="0.159 0 0.102"/></joint>
</robot>
