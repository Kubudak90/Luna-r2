<?xml version="1.0"?>
<!-- Luna R05 simplified kinematic model. Frames from CAD (mm → m) with ROS REP-103 axes:
     CAD front is −Y, so  x_ros = −Y_cad,  y_ros = +X_cad,  z_ros = Z_cad.
     NOTE: CAD part names *_L sit at X<0, i.e. on the robot's own RIGHT side (y_ros < 0).
     Pan axis CAD (0, 30, 355) about Z; tilt axis CAD (0, 30, 465) about X (= ROS y). -->
<robot name="luna">
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.235"/><geometry><box size="0.25 0.26 0.22"/></geometry></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <link name="track_left"><visual><origin xyz="0 0 0.072"/><geometry><box size="0.34 0.05 0.144"/></geometry></visual></link>
  <joint name="track_left_joint" type="fixed"><parent link="base_link"/><child link="track_left"/><origin xyz="0 0.159 0"/></joint>
  <link name="track_right"><visual><origin xyz="0 0 0.072"/><geometry><box size="0.34 0.05 0.144"/></geometry></visual></link>
  <joint name="track_right_joint" type="fixed"><parent link="base_link"/><child link="track_right"/><origin xyz="0 -0.159 0"/></joint>

  <link name="head_pan_link"/>
  <joint name="head_pan" type="revolute">
    <parent link="base_link"/><child link="head_pan_link"/><origin xyz="-0.030 0 0.355"/>
    <axis xyz="0 0 1"/><limit lower="-1.047" upper="1.047" effort="2.0" velocity="1.57"/>
  </joint>
  <link name="head_tilt_link">
    <visual><origin xyz="0.025 0 0.010"/><geometry><box size="0.11 0.24 0.09"/></geometry></visual>
  </link>
  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link"/><child link="head_tilt_link"/><origin xyz="0 0 0.110"/>
    <axis xyz="0 1 0"/><limit lower="-0.209" upper="0.209" effort="2.0" velocity="0.78"/>
  </joint>
  <link name="camera_left_link"/>
  <!-- R06 camera model (Arducam B0630): lens front Y−37, entrance pupil taken 3 mm behind it (the R06 FOV apex)
       → x 0.034 in base_link, 0.064 ahead of the tilt axis; lens centre Z475 and CAD X +62 for camera_left
       (REF_R06_CAM_R), X −62 for camera_right (REF_R06_CAM_L).
       *_optical_frame: ROS camera convention (z out of the lens, x right, y down), the frame_id of the images. -->
  <joint name="camera_left_joint" type="fixed"><parent link="head_tilt_link"/><child link="camera_left_link"/><origin xyz="0.064 0.062 0.010"/></joint>
  <link name="camera_left_optical_frame"/>
  <joint name="camera_left_optical_joint" type="fixed"><parent link="camera_left_link"/><child link="camera_left_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
  <link name="camera_right_link"/>
  <joint name="camera_right_joint" type="fixed"><parent link="head_tilt_link"/><child link="camera_right_link"/><origin xyz="0.064 -0.062 0.010"/></joint>
  <link name="camera_right_optical_frame"/>
  <joint name="camera_right_optical_joint" type="fixed"><parent link="camera_right_link"/><child link="camera_right_optical_frame"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>

  <!-- Sensor frames from the R08 CAD (R08_Derinlik_Kamerasi_ve_LiDAR/R08_Sensor_Pozlari_URDF.md, 18.10.2026). This file is
       the only place these poses are written: core/robot_model.py reads them for the simulator, dock_nav_node and the
       tests; Nav2 and SLAM get them through TF.
       RPLIDAR C1: turret axis at the datasheet laser height (29.8 mm above the C1 base, Z589.8). Yaw −90°: sllidar_ros2
       (C1 launch, inverted=false) puts +x toward the cable exit, which points to the robot's right. -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="-0.0700 0.0000 0.5898" rpy="0.0000 -0.0000 -1.5708"/></joint>

  <!-- Front depth camera: Luxonis OAK-D Lite (fixed focus) in the R08 P33 bracket. oakd_link = enclosure centre, x along
       the optical axes, 15° nose down. The optical frames carry depthai_ros_driver's names (camera name "oak"); depth
       is aligned to the RGB camera, so /oak/points comes in oak_rgb_camera_optical_frame. With depth:=oakd the driver
       publishes these three frames from its EEPROM calibration below oakd_link (parent_frame), and luna.launch.py
       drops them from this file so no frame has two parents. -->
  <link name="oakd_link"/>
  <joint name="oakd_link_joint" type="fixed"><parent link="base_link"/><child link="oakd_link"/><origin xyz="0.1050 0.0000 0.3650" rpy="-0.0000 0.2618 -0.0000"/></joint>
  <link name="oak_rgb_camera_optical_frame"/>
  <joint name="oak_rgb_camera_optical_frame_joint" type="fixed"><parent link="base_link"/><child link="oak_rgb_camera_optical_frame"/><origin xyz="0.1130 0.0000 0.3681" rpy="-1.8326 -0.0000 -1.5708"/></joint>
  <link name="oak_left_camera_optical_frame"/>
  <joint name="oak_left_camera_optical_frame_joint" type="fixed"><parent link="base_link"/><child link="oak_left_camera_optical_frame"/><origin xyz="0.1115 0.0375 0.3685" rpy="-1.8326 -0.0000 -1.5708"/></joint>
  <link name="oak_right_camera_optical_frame"/>
  <joint name="oak_right_camera_optical_frame_joint" type="fixed"><parent link="base_link"/><child link="oak_right_camera_optical_frame"/><origin xyz="0.1115 -0.0375 0.3685" rpy="-1.8326 -0.0000 -1.5708"/></joint>

  <!-- Corner ToF, Pololu #3415 VL53L1X (27° cone), chip face centre, +x along the beam: straight ahead / back, not
       diagonal. Names follow the robot's own sides and the /luna/mcu/corners order [FL, FR, BL, BR]; the CAD part
       suffixes are mirrored (tof_fl = CAD P20_F_R). Floor ToF, VL53L4CD (18° cone), +x straight down: tof_down_*
       (/luna/mcu/cliff order [FL, BL, FR, BR]; CAD P20_DOWN_1 = tof_down_fr, _2 = br, _3 = fl, _4 = bl). -->
  <link name="tof_fl"/>
  <joint name="tof_fl_joint" type="fixed"><parent link="base_link"/><child link="tof_fl"/><origin xyz="0.1689 0.0935 0.1010" rpy="-0.0000 -0.0000 0.0000"/></joint>
  <link name="tof_fr"/>
  <joint name="tof_fr_joint" type="fixed"><parent link="base_link"/><child link="tof_fr"/><origin xyz="0.1689 -0.0935 0.1010" rpy="-0.0000 -0.0000 0.0000"/></joint>
  <link name="tof_bl"/>
  <joint name="tof_bl_joint" type="fixed"><parent link="base_link"/><child link="tof_bl"/><origin xyz="-0.1689 0.0935 0.1010" rpy="0.0000 -0.0000 3.1416"/></joint>
  <link name="tof_br"/>
  <joint name="tof_br_joint" type="fixed"><parent link="base_link"/><child link="tof_br"/><origin xyz="-0.1689 -0.0935 0.1010" rpy="0.0000 -0.0000 3.1416"/></joint>
  <link name="tof_down_fl"/>
  <joint name="tof_down_fl_joint" type="fixed"><parent link="base_link"/><child link="tof_down_fl"/><origin xyz="0.1360 0.1085 0.0532" rpy="-0.0000 1.5708 0.0000"/></joint>
  <link name="tof_down_fr"/>
  <joint name="tof_down_fr_joint" type="fixed"><parent link="base_link"/><child link="tof_down_fr"/><origin xyz="0.1360 -0.1085 0.0532" rpy="-0.0000 1.5708 0.0000"/></joint>
  <link name="tof_down_bl"/>
  <joint name="tof_down_bl_joint" type="fixed"><parent link="base_link"/><child link="tof_down_bl"/><origin xyz="-0.1360 0.1085 0.0532" rpy="-0.0000 1.5708 0.0000"/></joint>
  <link name="tof_down_br"/>
  <joint name="tof_down_br_joint" type="fixed"><parent link="base_link"/><child link="tof_down_br"/><origin xyz="-0.1360 -0.1085 0.0532" rpy="-0.0000 1.5708 0.0000"/></joint>

  <link name="face_display"/>
  <joint name="face_display_joint" type="fixed"><parent link="base_link"/><child link="face_display"/><origin xyz="0.115 0 0.256" rpy="0 -0.1666 0"/></joint>
  <link name="dock_contact"/>
  <joint name="dock_contact_joint" type="fixed"><parent link="base_link"/><child link="dock_contact"/><origin xyz="0.159 0 0.102"/></joint>
</robot>
