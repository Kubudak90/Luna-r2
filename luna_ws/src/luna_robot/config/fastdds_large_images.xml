<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS (ROS 2 Humble default RMW) profile for camera images between processes on one host.
     Humble's built-in shared-memory transport uses 512 KB segments, so a 1280×720 image (0.9 MB mono8, 2.7 MB rgb8)
     falls back to UDP fragments; on loopback those overflow the socket buffer and the reliable retransmissions stall
     delivery for up to ~2 s (measured, README_TR "Kamera ve AprilTag ile dock"). A 4 MB segment carries them in
     shared memory. Each process maps one segment: give the container shm_size ≥ 256 MB.
     Use:  export FASTRTPS_DEFAULT_PROFILES_FILE=<share>/luna_robot/config/fastdds_large_images.xml -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_4mb</transport_id>
      <type>SHM</type>
      <segment_size>4194304</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="luna_large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_4mb</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
